{
  "manifest_version": 3,
  "name": "FeedGuard AI",
  "version": "1.0.0",
  "description": "AI-powered feed curator for YouTube and X (Twitter) — filters clickbait, prevents doomscrolling, summarizes content, and detects toxic/rage bait.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "FeedGuard AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/twitter.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:8000/*",
     "http://localhost:8000/*"
],
  "web_accessible_resources": [
    {
      "resources": ["popup/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:3001 http://localhost:8000 http://127.0.0.1:8000 https://fonts.googleapis.com https://fonts.gstatic.com;"
}  }

